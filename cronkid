#!/usr/bin/env bash
#
# cronkid - shell-based parental control that limits the usage time of a user.
#
# Usage:
#   cronkid setup --limit <minutes> [--user <username>]
#                                     configure and start the control service for the current
#                                     or the given user
#   cronkid remove [--user <username>]  stop and remove the control service
#   cronkid status [--user <username>]  show the remaining time
#   cronkid reset [--user <username>]   reset the used time
#   cronkid update                    replace this script with the latest version from the origin
#   cronkid uninstall                 remove the script, all services and all configuration
#
set -euo pipefail

CRONKID_REPO="sboe0705/cronkid"
CRONKID_BRANCH="main"
INSTALL_PATH="/usr/local/bin/cronkid"
SERVICE_NAME="cronkid.service"
USED_FILE_NAME=".cronkid"
# Seconds between two checks of the control service; each check adds one minute of used time.
TICK_SECONDS=60

die() {
    echo "cronkid: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: cronkid <command> [options]

Commands:
  setup --limit <minutes> [--user <username>]
                            configure and start the control service
  remove [--user <username>]
                            stop and remove the control service
  status [--user <username>]
                            show the remaining time
  reset [--user <username>]
                            reset the used time
  update                    replace this script with the latest version from the origin
  uninstall                 remove the script, all services and all configuration

Without --user, a command applies to the current user. With --user it applies to the given
user and requires root (sudo is used automatically).
EOF
}

# Re-executes the current command as root via sudo, unless already running as root.
require_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$(readlink -f "$0")" "$@"
    fi
}

require_non_root() {
    if [[ $EUID -eq 0 ]]; then
        die "this command must be run as the user to be controlled, not as root"
    fi
}

used_file() {
    echo "${HOME}/${USED_FILE_NAME}"
}

# Prints the used minutes of the current user for today. The used-time file holds
# "<date> <minutes>"; minutes recorded on another day count as 0 (daily reset).
read_used() {
    local file date="" used=""
    file="$(used_file)"
    read -r date used 2>/dev/null <"$file" || true
    [[ $date == "$(date +%F)" && $used =~ ^[0-9]+$ ]] || used=0
    echo "$used"
}

write_used() {
    local file
    file="$(used_file)"
    echo "$(date +%F) $1" >"${file}.tmp"
    mv -f "${file}.tmp" "$file"
}

# Prints the base URL to download from. raw.githubusercontent.com caches branch URLs for up to
# 5 minutes (and the GitHub API for 60 seconds), so the latest commit of the branch is read from
# the uncached git smart-HTTP ref advertisement and its immutable URL is used. Falls back to the
# (possibly stale) branch URL if that fails. CRONKID_URL overrides the origin, e.g. for testing.
origin_url() {
    if [[ -n ${CRONKID_URL:-} ]]; then
        echo "$CRONKID_URL"
        return
    fi
    local sha
    sha="$(curl -fsSL --retry 3 --connect-timeout 10 \
        "https://github.com/${CRONKID_REPO}.git/info/refs?service=git-upload-pack" 2>/dev/null \
        | grep -ao "[0-9a-f]\{40\} refs/heads/${CRONKID_BRANCH}\$" | head -n 1 | cut -c 1-40 || true)"
    if [[ $sha =~ ^[0-9a-f]{40}$ ]]; then
        echo "https://raw.githubusercontent.com/${CRONKID_REPO}/${sha}"
    else
        echo "cronkid: cannot resolve latest commit, falling back to branch '${CRONKID_BRANCH}' (may be up to 5 minutes old)" >&2
        echo "https://raw.githubusercontent.com/${CRONKID_REPO}/${CRONKID_BRANCH}"
    fi
}

service_dir() {
    echo "${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
}

# Prints the service unit that enforces the given limit.
service_unit() {
    cat <<EOF
[Unit]
Description=cronkid usage time control (limit: ${1} minutes)

[Service]
Type=simple
ExecStart=${INSTALL_PATH} run --limit ${1}
Restart=on-failure

[Install]
WantedBy=default.target
EOF
}

# Parses the "[--user <name>]" option of a command into USER_OPTION.
parse_user_option() {
    local cmd="$1"
    shift
    USER_OPTION=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)
                [[ $# -ge 2 ]] || die "--user requires a value"
                USER_OPTION="$2"
                shift 2
                ;;
            *) die "unknown option for ${cmd}: $1" ;;
        esac
    done
}

# Usage: for_other_user <user> <command> <original args...>
# Returns 1 if the command targets the current user (no user given, or the given user is oneself).
# Otherwise validates the user, re-executes the command via sudo if needed and returns 0 as root
# with TARGET_USER, TARGET_UID and TARGET_HOME set.
for_other_user() {
    local user="$1"
    shift
    [[ -n $user ]] || return 1
    [[ $EUID -ne 0 && $user == "$USER" ]] && return 1
    getent passwd "$user" >/dev/null || die "unknown user: ${user}"
    require_root "$@"
    TARGET_USER="$user"
    TARGET_UID="$(id -u "$user")"
    [[ $TARGET_UID -ne 0 ]] || die "the root user cannot be controlled"
    TARGET_HOME="$(getent passwd "$user" | cut -d: -f6)"
    [[ -d $TARGET_HOME ]] || die "home directory of user '${user}' not found: ${TARGET_HOME}"
}

# Runs a cronkid command as the target user, so that root never reads or writes the user's files.
run_as_target() {
    runuser -u "$TARGET_USER" -- env -u XDG_CONFIG_HOME HOME="$TARGET_HOME" USER="$TARGET_USER" \
        LOGNAME="$TARGET_USER" "$(readlink -f "$0")" "$@"
}

target_user_manager_active() {
    systemctl is-active --quiet "user@${TARGET_UID}.service"
}

cmd_setup() {
    local args=("$@") limit="" user=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit | --user)
                [[ $# -ge 2 ]] || die "$1 requires a value"
                if [[ $1 == --limit ]]; then limit="$2"; else user="$2"; fi
                shift 2
                ;;
            *) die "unknown option for setup: $1" ;;
        esac
    done
    [[ -n $limit ]] || die "setup requires --limit <minutes>"
    [[ $limit =~ ^[1-9][0-9]*$ ]] || die "--limit must be a positive number of minutes"

    if for_other_user "$user" setup "${args[@]}"; then
        setup_other_user "$limit"
    else
        setup_current_user "$limit"
    fi
}

setup_current_user() {
    require_non_root
    local limit="$1" dir
    dir="$(service_dir)"
    mkdir -p "$dir"
    service_unit "$limit" >"${dir}/${SERVICE_NAME}"

    systemctl --user daemon-reload
    systemctl --user enable "$SERVICE_NAME"
    systemctl --user restart "$SERVICE_NAME"
    echo "cronkid: control service configured for user '${USER}' with a limit of ${limit} minutes"
}

# Runs as root. All files are created as the target user (runuser), so they are owned by that user
# and root never writes through paths the user controls. Enabling is done by creating the same
# symlink as 'systemctl --user enable', which also works while the user is logged out.
setup_other_user() {
    local limit="$1" dir="${TARGET_HOME}/.config/systemd/user"
    runuser -u "$TARGET_USER" -- mkdir -p "${dir}/default.target.wants"
    service_unit "$limit" | runuser -u "$TARGET_USER" -- tee "${dir}/${SERVICE_NAME}" >/dev/null
    runuser -u "$TARGET_USER" -- ln -sfn "${dir}/${SERVICE_NAME}" "${dir}/default.target.wants/${SERVICE_NAME}"

    if target_user_manager_active; then
        systemctl --user --machine="${TARGET_USER}@" daemon-reload
        systemctl --user --machine="${TARGET_USER}@" restart "$SERVICE_NAME"
        echo "cronkid: control service configured and started for user '${TARGET_USER}'" \
            "with a limit of ${limit} minutes"
    else
        echo "cronkid: control service configured for user '${TARGET_USER}' with a limit of ${limit} minutes" \
            "(starts at the user's next login)"
    fi
}

cmd_remove() {
    parse_user_option remove "$@"
    if for_other_user "$USER_OPTION" remove "$@"; then
        remove_other_user
        return
    fi
    require_non_root
    local unit
    unit="$(service_dir)/${SERVICE_NAME}"
    [[ -f $unit ]] || die "no control service configured for user '${USER}'"
    systemctl --user disable --now "$SERVICE_NAME"
    rm -f "$unit"
    systemctl --user daemon-reload
    echo "cronkid: control service of user '${USER}' removed"
}

# Runs as root. Stops the service if the user is logged in and deletes the unit and its
# 'default.target.wants' symlink as the target user. The used time is kept.
remove_other_user() {
    local dir="${TARGET_HOME}/.config/systemd/user"
    [[ -f ${dir}/${SERVICE_NAME} ]] || die "no control service configured for user '${TARGET_USER}'"
    if target_user_manager_active; then
        systemctl --user --machine="${TARGET_USER}@" stop "$SERVICE_NAME" || true
    fi
    runuser -u "$TARGET_USER" -- rm -f "${dir}/${SERVICE_NAME}" "${dir}/default.target.wants/${SERVICE_NAME}"
    if target_user_manager_active; then
        systemctl --user --machine="${TARGET_USER}@" daemon-reload || true
    fi
    echo "cronkid: control service of user '${TARGET_USER}' removed"
}

# Prints the limit in minutes configured in the user's service, or nothing if there is none.
read_limit() {
    local unit
    unit="$(service_dir)/${SERVICE_NAME}"
    sed -n 's/^ExecStart=.* --limit \([0-9][0-9]*\)$/\1/p' "$unit" 2>/dev/null | head -n 1 || true
}

cmd_status() {
    parse_user_option status "$@"
    if for_other_user "$USER_OPTION" status "$@"; then
        run_as_target status
        return
    fi
    require_non_root
    local limit used
    limit="$(read_limit)"
    used="$(read_used)"
    if [[ -z $limit ]]; then
        echo "cronkid: no control service configured for user '${USER}' (used today: ${used} minutes)"
        return
    fi
    local remaining=$((limit > used ? limit - used : 0))
    echo "Remaining time of user '${USER}': ${remaining} minutes (used ${used} of ${limit} minutes today)"
}

cmd_reset() {
    parse_user_option reset "$@"
    if for_other_user "$USER_OPTION" reset "$@"; then
        run_as_target reset
        return
    fi
    require_non_root
    write_used 0
    echo "cronkid: used time of user '${USER}' reset"
}

# Locks the screen of every session of the user. Sessions that do not support a screen lock,
# such as the session of the user's service manager, are skipped.
lock_sessions() {
    local sessions session
    sessions="$(loginctl show-user "$USER" --property=Sessions --value 2>/dev/null)" || return 0
    # The property holds the session IDs separated by spaces.
    for session in $sessions; do
        loginctl lock-session "$session" >/dev/null 2>&1 || true
    done
}

# Internal command executed by the control service: counts the used minutes and locks the
# screen of the user as soon as the limit is reached.
cmd_run() {
    local limit=""
    if [[ ${1:-} == "--limit" && -n ${2:-} ]]; then
        limit="$2"
    fi
    [[ $limit =~ ^[1-9][0-9]*$ ]] || die "run requires --limit <minutes>"

    # The screen is locked again on every tick, so that unlocking it does not buy extra time.
    # Only the first lock of a series is logged, to keep the journal readable.
    local locked=0
    while true; do
        local used
        used="$(read_used)"
        if ((used >= limit)); then
            if ((locked == 0)); then
                echo "cronkid: limit of ${limit} minutes reached, locking the screen of user '${USER}'"
                locked=1
            fi
            lock_sessions
        else
            locked=0
        fi
        sleep "$TICK_SECONDS"
        write_used $(($(read_used) + 1))
    done
}

# Downloads the latest script next to the installed one and atomically replaces it. The running
# script keeps reading the old file, and a failed or invalid download leaves the current version intact.
cmd_update() {
    require_root update
    local base url tmp
    base="$(origin_url)"
    url="${base}/cronkid"
    tmp="$(mktemp "${INSTALL_PATH}.XXXXXX")" || die "cannot create temporary file next to ${INSTALL_PATH}"
    # The value is expanded now, because the trap runs after this function's locals are gone.
    trap "rm -f -- $(printf '%q' "$tmp")" EXIT

    curl -fsSL --retry 3 --connect-timeout 10 "$url" -o "$tmp" \
        || die "download from ${url} failed, keeping current version"
    [[ $(head -c 2 "$tmp") == "#!" ]] || die "downloaded file is not a script, keeping current version"
    bash -n "$tmp" || die "downloaded script is not valid bash, keeping current version"
    if cmp -s "$tmp" "$INSTALL_PATH"; then
        echo "cronkid: ${INSTALL_PATH} is already up to date"
        return
    fi
    chmod 0755 "$tmp"
    mv -f "$tmp" "$INSTALL_PATH" || die "cannot replace ${INSTALL_PATH}, keeping current version"
    echo "cronkid: updated ${INSTALL_PATH} from ${base}"
}

cmd_uninstall() {
    require_root uninstall
    local name uid home
    while IFS=: read -r name _ uid _ _ home _; do
        [[ -d $home ]] || continue
        local unit="${home}/.config/systemd/user/${SERVICE_NAME}"
        if [[ -f $unit ]]; then
            systemctl --user --machine="${name}@" stop "$SERVICE_NAME" 2>/dev/null || true
            rm -f "$unit" "${home}/.config/systemd/user/default.target.wants/${SERVICE_NAME}"
            systemctl --user --machine="${name}@" daemon-reload 2>/dev/null || true
            echo "cronkid: removed control service of user '${name}'"
        fi
        rm -f "${home}/${USED_FILE_NAME}" "${home}/${USED_FILE_NAME}.tmp"
    done < <(getent passwd)
    rm -f "$INSTALL_PATH"
    echo "cronkid: uninstalled"
}

main() {
    local cmd="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$cmd" in
        setup) cmd_setup "$@" ;;
        remove) cmd_remove "$@" ;;
        status) cmd_status "$@" ;;
        reset) cmd_reset "$@" ;;
        run) cmd_run "$@" ;;
        update) cmd_update "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        -h | --help | help) usage ;;
        "") usage >&2; exit 1 ;;
        *) echo "cronkid: unknown command: $cmd" >&2; usage >&2; exit 1 ;;
    esac
}

main "$@"
