#!/usr/bin/env bash
#
# cronkid - shell-based parental control that limits the usage time of a user.
#
# Usage:
#   cronkid setup --user <username> [--limit <minutes>] [--from <HH:MM> --until <HH:MM>]
#                 [--warn <minutes>]  configure and start the control service for the given user
#   cronkid remove --user <username>  stop and remove the control service
#   cronkid status [--user <username>]  show the remaining time
#   cronkid reset --user <username>   reset the used time and the automatic locks
#   cronkid update                    replace this script with the latest version from the origin
#   cronkid uninstall                 remove the script, all services and all configuration
#
set -euo pipefail

CRONKID_REPO="sboe0705/cronkid"
CRONKID_BRANCH="stable"
INSTALL_PATH="/usr/local/bin/cronkid"
# Configuration (<user>.conf) and state (<user>) of the controlled users. Both are owned by root and
# readable by everyone, so that the user can see the status but not change it.
CONFIG_DIR="/etc/cronkid"
STATE_DIR="/var/lib/cronkid"
UNIT_PATH="/etc/systemd/system/cronkid@.service"
# The runtime directories of the users, /run/user/<uid>, which hold their session bus.
RUNTIME_DIR="/run/user"
# The user service and used-time file of versions before the system service. They are removed by
# setup, remove and uninstall.
LEGACY_SERVICE_NAME="cronkid.service"
LEGACY_USED_FILE_NAME=".cronkid"
# Version of this script: date and time (without seconds) of the commit it was installed from, and
# the short commit ID. The installer and 'cronkid update' fill this line in, so it is empty in a
# working copy of the repository.
CRONKID_VERSION=""
# Seconds of checks that add one minute of used time.
TICK_SECONDS=60
# Seconds between two checks of the control service. The checks are more frequent than a minute of
# used time, so that a notification the desktop was not ready for yet and a new login do not have to
# wait for the next minute.
CHECK_SECONDS=5
# Minutes before the end at which the first warning is shown, unless --warn says otherwise.
DEFAULT_WARN_MINUTES=5
# Minutes before the lock at which the last warning is shown. Unlike the first warning, this one
# is not configurable.
FINAL_WARN_MINUTES=1
# Seconds the screen stays unlocked after a login or an unlock in the last minute or past the end. It
# matches the last warning, which is what the user is told then.
LOCK_GRACE_SECONDS=$((FINAL_WARN_MINUTES * 60))
# Automatic screen locks per day. The last of them shuts the computer down, and so does every further
# login until the next day.
MAX_LOCKS=5
# Seconds between the shutdown warning and the shutdown.
SHUTDOWN_WARN_SECONDS=10
# Seconds the shutdown waits for the desktop to show its warning before the countdown starts anyway.
SHUTDOWN_DELIVERY_SECONDS=30

die() {
    echo "cronkid: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: cronkid <command> [options]

Commands:
  setup --user <username> [--limit <minutes>] [--from <HH:MM> --until <HH:MM>] [--warn <minutes>]
                            configure and start the control service: the user may use the
                            computer --limit minutes a day and/or only from --from until
                            --until, is warned --warn minutes (default ${DEFAULT_WARN_MINUTES}) and 1 minute
                            before the end, and gets the screen locked at the end
  remove --user <username>  stop and remove the control service
  status [--user <username>]
                            show the remaining time
  reset --user <username>   reset today's used time and automatic locks
  update                    replace this script with the latest version from the origin
  version                   show the version of this script
  uninstall                 remove the script, all services and all configuration

setup, remove, reset, update and uninstall require root (sudo is used automatically).
status without --user shows the status of the current user.
EOF
}

# Re-executes the current command as root via sudo, unless already running as root.
require_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$(readlink -f "$0")" "$@"
    fi
}

# Parses the "[--user <name>]" option of a command into USER_OPTION.
parse_user_option() {
    local cmd="$1"
    shift
    USER_OPTION=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)
                [[ $# -ge 2 ]] || die "--user requires a value"
                USER_OPTION="$2"
                shift 2
                ;;
            *) die "unknown option for ${cmd}: $1" ;;
        esac
    done
}

# Validates the user <1>, who must exist and must not be root, and sets TARGET_USER, TARGET_UID and
# TARGET_HOME. The name is also used in file names, so it may not contain a path.
check_user() {
    local user="$1"
    [[ $user =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || die "invalid user name: ${user}"
    getent passwd "$user" >/dev/null || die "unknown user: ${user}"
    TARGET_USER="$user"
    TARGET_UID="$(id -u "$user")"
    [[ $TARGET_UID -ne 0 ]] || die "the root user cannot be controlled"
    TARGET_HOME="$(getent passwd "$user" | cut -d: -f6)"
}

# Returns 0 if <1> is a time of day as HH:MM.
valid_time() {
    [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]
}

# Prints the minutes since midnight of the time of day <1> (HH:MM).
time_minutes() {
    echo $((10#${1%%:*} * 60 + 10#${1##*:}))
}

# Prints the minutes since midnight of the current time.
clock_minutes() {
    time_minutes "$(date +%H:%M)"
}

# Prints "1 minute" or "<n> minutes".
minutes_phrase() {
    if (($1 == 1)); then echo "1 minute"; else echo "${1} minutes"; fi
}

# Prints the minutes before the end at which the first warning is shown: the given value <2>, or the
# default if it is empty. A warning that would not fit into the limit <1> is moved to the last
# minute, where it coincides with the last warning.
effective_warn() {
    local limit="$1" warn="${2:-$DEFAULT_WARN_MINUTES}"
    if [[ -n $limit ]] && ((warn >= limit)); then warn=$FINAL_WARN_MINUTES; fi
    echo "$warn"
}

config_file() {
    echo "${CONFIG_DIR}/${1}.conf"
}

state_file() {
    echo "${STATE_DIR}/${1}"
}

# Reads the configuration of the user <1> into CFG_LIMIT, CFG_FROM, CFG_UNTIL and CFG_WARN, which
# are empty if not configured. Returns 1 if the user has no configuration. The file is parsed, not
# sourced, and invalid values are ignored.
read_config() {
    local file key value
    file="$(config_file "$1")"
    CFG_LIMIT="" CFG_FROM="" CFG_UNTIL="" CFG_WARN=""
    [[ -f $file ]] || return 1
    while IFS='=' read -r key value; do
        case "$key" in
            LIMIT) if [[ $value =~ ^[1-9][0-9]*$ ]]; then CFG_LIMIT="$value"; fi ;;
            WARN) if [[ $value =~ ^[1-9][0-9]*$ ]]; then CFG_WARN="$value"; fi ;;
            FROM) if valid_time "$value"; then CFG_FROM="$value"; fi ;;
            UNTIL) if valid_time "$value"; then CFG_UNTIL="$value"; fi ;;
        esac
    done <"$file"
    # A period is only valid as a whole.
    if [[ -z $CFG_FROM || -z $CFG_UNTIL ]]; then
        CFG_FROM="" CFG_UNTIL=""
    fi
    return 0
}

# Prints the day the automatic locks count for. With an allowed period it starts at CFG_FROM, so a
# user who is locked out in the evening stays locked out after midnight; without one at midnight.
period_day() {
    if [[ -n $CFG_FROM ]] && (($(clock_minutes) < $(time_minutes "$CFG_FROM"))); then
        date -d yesterday +%F
    else
        date +%F
    fi
}

# Reads the state of the user <1> into USED (minutes used today) and LOCKS (automatic locks of
# the current period day). The state file holds "<date> <minutes> <period day> <locks>"; values
# recorded for another day count as 0, which is the daily reset. Uses CFG_FROM.
read_state() {
    local date="" used="" day="" locks=""
    read -r date used day locks 2>/dev/null <"$(state_file "$1")" || true
    [[ $date == "$(date +%F)" && $used =~ ^[0-9]+$ ]] || used=0
    [[ $day == "$(period_day)" && $locks =~ ^[0-9]+$ ]] || locks=0
    USED="$used"
    LOCKS="$locks"
}

# Writes the used minutes <2> and the automatic locks <3> of the user <1> for today. Uses CFG_FROM.
write_state() {
    local file
    file="$(state_file "$1")"
    mkdir -p "$STATE_DIR"
    echo "$(date +%F) $2 $(period_day) $3" >"${file}.tmp"
    chmod 0644 "${file}.tmp"
    mv -f "${file}.tmp" "$file"
}

# Sets REMAINING to the minutes left until the user has to stop, from the used minutes USED and the
# configuration: the rest of the limit or the time until the end of the allowed period, whichever is
# smaller, and 0 outside the period. REASON says which of the two ends first: "limit" or "period".
remaining_minutes() {
    local rest_limit="" rest_period=""
    if [[ -n $CFG_LIMIT ]]; then
        rest_limit=$((CFG_LIMIT > USED ? CFG_LIMIT - USED : 0))
    fi
    if [[ -n $CFG_FROM ]]; then
        local now from until
        now="$(clock_minutes)"
        from="$(time_minutes "$CFG_FROM")"
        until="$(time_minutes "$CFG_UNTIL")"
        if ((now < from || now >= until)); then
            rest_period=0
        else
            rest_period=$((until - now))
        fi
    fi
    if [[ -z $rest_limit ]] || { [[ -n $rest_period ]] && ((rest_period < rest_limit)); }; then
        REMAINING="$rest_period"
        REASON="period"
    else
        REMAINING="$rest_limit"
        REASON="limit"
    fi
}

# Prints the allowed period of the configuration as "<from>-<until>".
period_phrase() {
    echo "${CFG_FROM}-${CFG_UNTIL}"
}

# Prints a description of the configuration, e.g. "limit of 120 minutes, allowed 08:00-20:00".
config_phrase() {
    local phrase=""
    if [[ -n $CFG_LIMIT ]]; then phrase="limit of $(minutes_phrase "$CFG_LIMIT")"; fi
    if [[ -n $CFG_LIMIT && -n $CFG_FROM ]]; then phrase="${phrase}, "; fi
    if [[ -n $CFG_FROM ]]; then phrase="${phrase}allowed $(period_phrase)"; fi
    echo "$phrase"
}

# Prints the base URL to download from. raw.githubusercontent.com caches branch URLs for up to
# 5 minutes (and the GitHub API for 60 seconds), so the latest commit of the branch is read from
# the uncached git smart-HTTP ref advertisement and its immutable URL is used. Falls back to the
# (possibly stale) branch URL if that fails. CRONKID_URL overrides the origin, e.g. for testing.
origin_url() {
    if [[ -n ${CRONKID_URL:-} ]]; then
        echo "$CRONKID_URL"
        return
    fi
    local sha
    sha="$(curl -fsSL --retry 3 --connect-timeout 10 \
        "https://github.com/${CRONKID_REPO}.git/info/refs?service=git-upload-pack" 2>/dev/null \
        | grep -ao "[0-9a-f]\{40\} refs/heads/${CRONKID_BRANCH}\$" | head -n 1 | cut -c 1-40 || true)"
    if [[ $sha =~ ^[0-9a-f]{40}$ ]]; then
        echo "https://raw.githubusercontent.com/${CRONKID_REPO}/${sha}"
    else
        echo "cronkid: cannot resolve latest commit, falling back to branch '${CRONKID_BRANCH}' (may be up to 5 minutes old)" >&2
        echo "https://raw.githubusercontent.com/${CRONKID_REPO}/${CRONKID_BRANCH}"
    fi
}

# Prints the version of the commit <1>: its date and time in UTC, without seconds, and the short
# commit ID, for example "2026-09-20 03:03 UTC b12c9b6". The date of the commit comes from the
# GitHub API, which is only asked while installing or updating; if that fails, only the ID is used.
commit_version() {
    local sha="$1" date
    date="$(curl -fsSL --retry 2 --connect-timeout 10 \
        "https://api.github.com/repos/${CRONKID_REPO}/commits/${sha}" 2>/dev/null \
        | grep -o '"date": *"[0-9-]\{10\}T[0-9:]\{8\}Z"' | head -n 1 \
        | grep -o '[0-9-]\{10\}T[0-9:]\{5\}' | tr 'T' ' ' || true)"
    if [[ -n $date ]]; then
        echo "${date} UTC ${sha:0:7}"
    else
        echo "${sha:0:7}"
    fi
}

# Writes the version <2> into the CRONKID_VERSION line of the script <1>, which is where
# 'cronkid version' reads it from. Returns non-zero without touching the file if the version is not
# plain text or if the script has no such line, as an older version of it has.
stamp_version() {
    local file="$1" version="$2"
    [[ $version =~ ^[0-9A-Za-z\ :-]+$ ]] || return 1
    grep -q '^CRONKID_VERSION=""$' "$file" || return 1
    sed -i "s|^CRONKID_VERSION=\"\"\$|CRONKID_VERSION=\"${version}\"|" "$file"
}

# Prints the system service template; the instance name is the controlled user. It runs as root from
# boot on, so the user can neither stop it nor change its files.
service_unit() {
    cat <<EOF
[Unit]
Description=cronkid usage time control for user %i
After=systemd-logind.service

[Service]
Type=simple
ExecStart=${INSTALL_PATH} run --user %i
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
}

# Runs as root. Stops and removes the user service of an older version of cronkid for TARGET_USER,
# including its 'default.target.wants' symlink, as the target user, so that root never writes
# through paths the user controls.
remove_legacy_service() {
    local dir="${TARGET_HOME}/.config/systemd/user"
    [[ -e ${dir}/${LEGACY_SERVICE_NAME} || -L ${dir}/default.target.wants/${LEGACY_SERVICE_NAME} ]] || return 0
    local active=0
    if systemctl is-active --quiet "user@${TARGET_UID}.service"; then active=1; fi
    if ((active == 1)); then
        systemctl --user --machine="${TARGET_USER}@" stop "$LEGACY_SERVICE_NAME" 2>/dev/null || true
    fi
    runuser -u "$TARGET_USER" -- rm -f "${dir}/${LEGACY_SERVICE_NAME}" \
        "${dir}/default.target.wants/${LEGACY_SERVICE_NAME}"
    if ((active == 1)); then
        systemctl --user --machine="${TARGET_USER}@" daemon-reload 2>/dev/null || true
    fi
    echo "cronkid: removed the user service of an older version for user '${TARGET_USER}'"
}

cmd_setup() {
    local args=("$@") limit="" from="" until="" warn="" user=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit | --from | --until | --warn | --user)
                [[ $# -ge 2 ]] || die "$1 requires a value"
                case "$1" in
                    --limit) limit="$2" ;;
                    --from) from="$2" ;;
                    --until) until="$2" ;;
                    --warn) warn="$2" ;;
                    *) user="$2" ;;
                esac
                shift 2
                ;;
            *) die "unknown option for setup: $1" ;;
        esac
    done
    [[ -n $user ]] || die "setup requires --user <username>"
    [[ -n $limit || -n $from || -n $until ]] || die "setup requires --limit <minutes> and/or --from <HH:MM> --until <HH:MM>"
    [[ -z $limit || $limit =~ ^[1-9][0-9]*$ ]] || die "--limit must be a positive number of minutes"
    [[ -z $warn || $warn =~ ^[1-9][0-9]*$ ]] || die "--warn must be a positive number of minutes"
    if [[ -n $from || -n $until ]]; then
        [[ -n $from && -n $until ]] || die "--from and --until must be given together"
        valid_time "$from" || die "--from must be a time of day as HH:MM"
        valid_time "$until" || die "--until must be a time of day as HH:MM"
        (($(time_minutes "$from") < $(time_minutes "$until"))) || die "--from must be earlier than --until"
    fi
    check_user "$user"
    require_root setup "${args[@]}"

    mkdir -p "$CONFIG_DIR"
    local file
    file="$(config_file "$user")"
    {
        echo "LIMIT=${limit}"
        echo "FROM=${from}"
        echo "UNTIL=${until}"
        echo "WARN=${warn}"
    } >"${file}.tmp"
    chmod 0644 "${file}.tmp"
    mv -f "${file}.tmp" "$file"
    service_unit >"$UNIT_PATH"
    remove_legacy_service

    systemctl daemon-reload
    systemctl enable --quiet "cronkid@${user}.service"
    systemctl restart "cronkid@${user}.service"
    read_config "$user"
    echo "cronkid: control service configured and started for user '${user}' ($(config_phrase)," \
        "first warning at $(minutes_phrase "$(effective_warn "$CFG_LIMIT" "$CFG_WARN")") left)"
}

cmd_remove() {
    parse_user_option remove "$@"
    [[ -n $USER_OPTION ]] || die "remove requires --user <username>"
    check_user "$USER_OPTION"
    require_root remove "$@"
    local file
    file="$(config_file "$TARGET_USER")"
    [[ -f $file ]] || die "no control service configured for user '${TARGET_USER}'"
    systemctl disable --now --quiet "cronkid@${TARGET_USER}.service" || true
    rm -f "$file"
    remove_legacy_service
    echo "cronkid: control service of user '${TARGET_USER}' removed"
}

cmd_status() {
    parse_user_option status "$@"
    local user="${USER_OPTION:-$USER}"
    [[ $user =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || die "invalid user name: ${user}"
    getent passwd "$user" >/dev/null || die "unknown user: ${user}"
    if ! read_config "$user"; then
        echo "cronkid: no control service configured for user '${user}'"
        return
    fi
    read_state "$user"
    remaining_minutes
    echo "Remaining time of user '${user}': $(minutes_phrase "$REMAINING")"
    if [[ -n $CFG_LIMIT ]]; then
        echo "  used ${USED} of ${CFG_LIMIT} minutes today"
    fi
    if [[ -n $CFG_FROM ]]; then
        echo "  allowed from ${CFG_FROM} until ${CFG_UNTIL}"
    fi
    if ((LOCKS >= MAX_LOCKS)); then
        local until="midnight"
        if [[ -n $CFG_FROM ]]; then until="${CFG_FROM}"; fi
        echo "  locked out until ${until}: a login shuts the computer down"
    else
        echo "  automatic locks: ${LOCKS} of ${MAX_LOCKS}"
    fi
}

cmd_reset() {
    parse_user_option reset "$@"
    [[ -n $USER_OPTION ]] || die "reset requires --user <username>"
    check_user "$USER_OPTION"
    require_root reset "$@"
    read_config "$TARGET_USER" || true
    write_state "$TARGET_USER" 0 0
    echo "cronkid: used time and automatic locks of user '${TARGET_USER}' reset"
}

# Shows a desktop notification in the sessions of the user <1>. Returns non-zero if the message could
# not be delivered, for example because the notification daemon of the desktop is not up yet; the
# caller then tries again later. Without notify-send there is nothing to retry, so it returns 0.
notify_user() {
    local user="$1" urgency="$2" body="$3" uid bus
    command -v notify-send >/dev/null 2>&1 || return 0
    uid="$(id -u "$user" 2>/dev/null)" || return 1
    bus="${RUNTIME_DIR}/${uid}/bus"
    [[ -S $bus ]] || return 1
    runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}" \
        notify-send --app-name=cronkid --urgency="$urgency" "Screen time" "$body" 2>/dev/null
}

# Shows the message <2> once to every logged-in user except <1>.
notify_others() {
    local user="$1" body="$2" name
    while read -r _ name _; do
        [[ -n $name && $name != "$user" ]] || continue
        notify_user "$name" critical "$body" || true
    done < <(loginctl list-users --no-legend 2>/dev/null || true)
}

# Prints the IDs of the login sessions of the user <1>, one per line: graphical and text logins, but
# neither the session of the user's service manager nor sessions that are closing after a logout.
user_sessions() {
    local sessions session class state
    sessions="$(loginctl show-user "$1" --property=Sessions --value 2>/dev/null)" || return 0
    # The property holds the session IDs separated by spaces.
    for session in $sessions; do
        class="$(loginctl show-session "$session" --property=Class --value 2>/dev/null)" || continue
        state="$(loginctl show-session "$session" --property=State --value 2>/dev/null)" || continue
        if [[ $class == user* && $state != "closing" ]]; then
            echo "$session"
        fi
    done
}

# Locks the screen of every session of the user <1>.
lock_sessions() {
    local session
    for session in $(user_sessions "$1"); do
        loginctl lock-session "$session" >/dev/null 2>&1 || true
    done
}

# Returns 0 if a session of the user <1> reports itself as locked. Screen lockers set this hint once
# they have taken over the screen, which is the only way to notice that a lock request was lost
# because the locker was not running yet, and that the user unlocked the screen; a locker that does
# not set the hint is never reported as locked.
sessions_locked() {
    local session
    for session in $(user_sessions "$1"); do
        if [[ $(loginctl show-session "$session" --property=LockedHint --value 2>/dev/null) == "yes" ]]; then
            return 0
        fi
    done
    return 1
}

# Prints the stage of the countdown for <1> remaining minutes with the first warning at <2> minutes:
# "up" once the time is used up, "final" for the last minute before the lock, "warn" from the first
# warning on and "ok" before that. The user is notified once for every stage the countdown enters.
countdown_stage() {
    local remaining="$1" warn="$2"
    if ((remaining == 0)); then
        echo "up"
    elif ((remaining <= FINAL_WARN_MINUTES)); then
        echo "final"
    elif ((remaining <= warn)); then
        echo "warn"
    else
        echo "ok"
    fi
}

# Prints the warning for the last minute, given LOCKS: the lock, or the shutdown if it is the last
# automatic lock of the day.
final_warning() {
    local next=$((LOCKS + 1))
    if ((next >= MAX_LOCKS)); then
        echo "The computer will shut down in $(minutes_phrase "$FINAL_WARN_MINUTES")."
    else
        echo "Your screen will be locked in $(minutes_phrase "$FINAL_WARN_MINUTES")" \
            "(automatic lock ${next} of ${MAX_LOCKS}; the last one shuts the computer down)."
    fi
}

# Internal command executed by the control service: counts the used minutes, warns the user before
# the end, locks the screen at the end and shuts the computer down after the last automatic lock.
cmd_run() {
    if [[ ${1:-} == "--limit" ]]; then
        # A user service of an older version. Exiting successfully keeps systemd from restarting it.
        echo "cronkid: this user service is no longer used; run 'sudo cronkid setup --user ${USER} ...'" >&2
        exit 0
    fi
    parse_user_option run "$@"
    [[ -n $USER_OPTION ]] || die "run requires --user <username>"
    check_user "$USER_OPTION"
    local user="$TARGET_USER" warn
    read_config "$user" || die "no configuration for user '${user}' in ${CONFIG_DIR}"
    warn="$(effective_warn "$CFG_LIMIT" "$CFG_WARN")"
    local shutdown_message="The computer will shut down in ${SHUTDOWN_WARN_SECONDS} seconds."

    # The state of the loop:
    #   stage           the stage of the countdown the user was last notified of
    #   pending_*       the notification that still has to be delivered
    #   seen_sessions   the sessions of the previous check, to recognise a login
    #   grace_left      seconds until the lock, granted by a login or an unlock in the last minute
    #                   or later
    #   lock_state      idle         nothing is locked: there is time left, or a grace period runs
    #                   locking      the lock was sent, no session reports itself as locked yet
    #                   locked       a session reports the lock, so an unlock can be noticed
    #                   unconfirmed  no session reported the lock within a minute
    #   shutting_down   the shutdown has been announced
    #   shutdown_wait   seconds left for the desktop to show the shutdown warning
    #   shutdown_left   seconds until the shutdown once the warning is shown, -1 before
    local stage="" pending_urgency="" pending_body="" seen_sessions=" "
    local grace_left=0 lock_state="idle" shutting_down=0 shutdown_wait=0 shutdown_left=-1
    local elapsed=0 minute_done=0
    while true; do
        local sessions=" " session new_login=0 unlocked=0 current pause="$CHECK_SECONDS"
        # The service runs from boot on, so every session that is new since the last check is a
        # login, including the sessions that already exist at the first check.
        for session in $(user_sessions "$user"); do
            sessions="${sessions}${session} "
            [[ $seen_sessions == *" ${session} "* ]] || new_login=1
        done
        seen_sessions="$sessions"

        # The state is re-read on every check, so that 'cronkid reset' takes effect right away.
        read_state "$user"
        remaining_minutes
        current="$(countdown_stage "$REMAINING" "$warn")"

        # A screen that reported the lock and does not report it any more was unlocked by the user,
        # who is then treated like someone who just logged in.
        if [[ $current == "up" && $lock_state == "locked" ]] && ! sessions_locked "$user"; then
            unlocked=1
        fi
        if ((new_login == 1 || unlocked == 1)); then
            lock_state="idle"
            grace_left=0
        fi
        if ((shutting_down == 1)) && [[ $current != "up" ]]; then
            # There is time again, after 'cronkid reset' or a new setup.
            shutting_down=0
            shutdown_left=-1
        fi

        # Every login, every unlock and every stage the countdown enters is announced. The message is
        # only queued here; it is sent below and retried until it arrives.
        if ((new_login == 1 || unlocked == 1)) || [[ $current != "$stage" ]]; then
            pending_urgency="normal"
            pending_body=""
            case "$current" in
                ok)
                    if [[ $REASON == "period" ]]; then
                        pending_body="You can use the computer until ${CFG_UNTIL} today ($(minutes_phrase "$REMAINING") left)."
                    else
                        pending_body="$(minutes_phrase "$REMAINING") of screen time left today."
                    fi
                    ;;
                warn)
                    pending_body="Your screen will be locked in $(minutes_phrase "$REMAINING")."
                    ;;
                final)
                    pending_urgency="critical"
                    pending_body="$(final_warning)"
                    ;;
                up)
                    # A user who comes back after the end is told about the lock the grace period
                    # below holds back. A session that was already running was warned a minute ago
                    # and is locked right away, and a shutdown brings its own warning.
                    if ((new_login == 1 || unlocked == 1)) && ((LOCKS < MAX_LOCKS)); then
                        pending_urgency="critical"
                        pending_body="$(final_warning)"
                    fi
                    ;;
            esac
            # Whoever logs in or unlocks the screen during the last minute or after the end gets the
            # minute they were just promised.
            if ((new_login == 1 || unlocked == 1)) && [[ $current == "final" || $current == "up" ]]; then
                grace_left=$LOCK_GRACE_SECONDS
            fi
            stage="$current"
        fi

        if [[ $stage != "up" ]]; then
            # There is time left again, after 'cronkid reset', at midnight or at the start of the
            # allowed period.
            lock_state="idle"
        elif [[ $sessions != " " && $shutting_down -eq 0 ]]; then
            if ((LOCKS >= MAX_LOCKS)) || { ((grace_left == 0 && LOCKS + 1 >= MAX_LOCKS)) && [[ $lock_state == "idle" ]]; }; then
                # The last automatic lock, or a login after it: the computer is shut down. The lock
                # is counted first, so that a reboot does not end the lockout.
                shutting_down=1
                shutdown_wait=$SHUTDOWN_DELIVERY_SECONDS
                shutdown_left=-1
                pending_urgency="critical"
                pending_body="$shutdown_message"
                if ((LOCKS < MAX_LOCKS)); then write_state "$user" "$USED" "$MAX_LOCKS"; fi
                echo "cronkid: user '${user}' reached ${MAX_LOCKS} automatic locks, shutting down in ${SHUTDOWN_WARN_SECONDS} seconds"
            elif ((grace_left == 0)); then
                case "$lock_state" in
                    idle)
                        # Each lock after the end, a login or an unlock is counted, and it is the
                        # only one of its series that is logged.
                        write_state "$user" "$USED" $((LOCKS + 1))
                        if [[ $REASON == "period" ]]; then
                            echo "cronkid: outside of the allowed period $(period_phrase), locking the screen of user '${user}' (automatic lock $((LOCKS + 1)) of ${MAX_LOCKS})"
                        else
                            echo "cronkid: limit of ${CFG_LIMIT} minutes reached, locking the screen of user '${user}' (automatic lock $((LOCKS + 1)) of ${MAX_LOCKS})"
                        fi
                        lock_sessions "$user"
                        lock_state="locking"
                        ;;
                    locking)
                        # loginctl reports success even when nobody locked the screen, and right
                        # after a login the screen locker of the desktop is often not up yet, so the
                        # lock is repeated until a session confirms it.
                        if sessions_locked "$user"; then
                            lock_state="locked"
                        else
                            lock_sessions "$user"
                            # A locker that does not report the hint has had its chance after a
                            # minute; repeating the lock on every check would leave no time at all.
                            if ((minute_done == 1)); then lock_state="unconfirmed"; fi
                        fi
                        ;;
                    locked)
                        # Nothing to do: the unlock is noticed at the top of the next check.
                        ;;
                    unconfirmed)
                        # Without the hint an unlock cannot be told apart from a lock that was lost,
                        # so the screen is locked again with every counted minute, as a fallback.
                        # These locks are not counted, so that a user who just left the locked
                        # screen is not shut down. A locker that starts reporting the hint later is
                        # picked up here.
                        if sessions_locked "$user"; then
                            lock_state="locked"
                        elif ((minute_done == 1)); then
                            lock_sessions "$user"
                        fi
                        ;;
                esac
            fi
        fi

        # Nobody is there to read a message, and the next login brings its own.
        if [[ $sessions == " " ]]; then
            pending_body=""
        fi
        # At login the service usually notices the session before the notification daemon of the
        # desktop is up, so a message that was not delivered is retried on the following checks.
        if [[ -n $pending_body ]] && notify_user "$user" "$pending_urgency" "$pending_body"; then
            pending_body=""
        fi

        if ((shutting_down == 1)); then
            if ((shutdown_left < 0)); then
                # The countdown starts once the user has seen the warning, or after a while if the
                # desktop does not show it. Other users only get told once.
                if [[ -z $pending_body ]] || ((shutdown_wait <= 0)); then
                    shutdown_left=$SHUTDOWN_WARN_SECONDS
                    notify_others "$user" "$shutdown_message (cronkid: user '${user}' is locked out for today)"
                fi
            elif ((shutdown_left == 0)); then
                echo "cronkid: shutting down"
                systemctl poweroff -i || true
                # Tried again a minute later, should the shutdown not have happened.
                shutdown_left=$TICK_SECONDS
            fi
            # The shutdown counts seconds.
            pause=1
        fi

        minute_done=0
        sleep "$pause"
        if [[ $sessions != " " ]]; then
            elapsed=$((elapsed + pause))
            if ((elapsed >= TICK_SECONDS)); then
                elapsed=0
                read_state "$user"
                write_state "$user" $((USED + 1)) "$LOCKS"
                minute_done=1
            fi
        fi
        grace_left=$((grace_left > pause ? grace_left - pause : 0))
        shutdown_wait=$((shutdown_wait - pause))
        if ((shutdown_left > 0)); then
            shutdown_left=$((shutdown_left > pause ? shutdown_left - pause : 0))
        fi
    done
}

# Prints the version <1> with its UTC time converted to the time zone of this machine, for example
# "2026-09-20 05:03 CEST b12c9b6". The version is stamped in as UTC because the machine that installs
# the script is not necessarily the one that runs it. A version that holds no time, and one that
# 'date' cannot read, is printed unchanged.
local_version() {
    local version="$1" utc="" rest="" stamp=""
    if [[ $version =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2})\ UTC\ (.*)$ ]]; then
        utc="${BASH_REMATCH[1]}"
        rest="${BASH_REMATCH[2]}"
        stamp="$(date -d "${utc} UTC" '+%F %H:%M %Z' 2>/dev/null || true)"
    fi
    if [[ -n $stamp ]]; then
        echo "${stamp} ${rest}"
    else
        echo "$version"
    fi
}

cmd_version() {
    if [[ -n $CRONKID_VERSION ]]; then
        echo "cronkid $(local_version "$CRONKID_VERSION")"
    else
        echo "cronkid: no version, this script was not installed by install.sh or 'cronkid update'"
    fi
}

# Downloads the latest script next to the installed one and atomically replaces it. The running
# script keeps reading the old file, and a failed or invalid download leaves the current version intact.
cmd_update() {
    require_root update
    local base url tmp sha version="" suffix=""
    base="$(origin_url)"
    url="${base}/cronkid"
    tmp="$(mktemp "${INSTALL_PATH}.XXXXXX")" || die "cannot create temporary file next to ${INSTALL_PATH}"
    # The value is expanded now, because the trap runs after this function's locals are gone.
    # shellcheck disable=SC2064
    trap "rm -f -- $(printf '%q' "$tmp")" EXIT

    curl -fsSL --retry 3 --connect-timeout 10 "$url" -o "$tmp" \
        || die "download from ${url} failed, keeping current version"
    [[ $(head -c 2 "$tmp") == "#!" ]] || die "downloaded file is not a script, keeping current version"
    # The origin URL ends in the commit the script comes from, unless it fell back to the branch.
    # The version is written into the downloaded script, because a running script cannot know which
    # commit it came from.
    sha="${base##*/}"
    if [[ $sha =~ ^[0-9a-f]{40}$ ]]; then
        version="$(commit_version "$sha")"
        stamp_version "$tmp" "$version" || version=""
    fi
    if [[ -n $version ]]; then
        suffix=" (version ${version})"
    fi
    bash -n "$tmp" || die "downloaded script is not valid bash, keeping current version"
    if cmp -s "$tmp" "$INSTALL_PATH"; then
        echo "cronkid: ${INSTALL_PATH} is already up to date"
        return
    fi
    chmod 0755 "$tmp"
    mv -f "$tmp" "$INSTALL_PATH" || die "cannot replace ${INSTALL_PATH}, keeping current version"
    echo "cronkid: updated ${INSTALL_PATH} from ${base}${suffix}"
    # The running control services still execute the old script.
    systemctl try-restart 'cronkid@*.service' 2>/dev/null || true
}

cmd_uninstall() {
    require_root uninstall
    local name uid home
    while IFS=: read -r name _ uid _ _ home _; do
        if [[ -f $(config_file "$name") ]] || systemctl is-enabled --quiet "cronkid@${name}.service" 2>/dev/null \
            || systemctl is-active --quiet "cronkid@${name}.service" 2>/dev/null; then
            systemctl disable --now --quiet "cronkid@${name}.service" 2>/dev/null || true
            echo "cronkid: removed control service of user '${name}'"
        fi
        [[ -d $home ]] || continue
        # Leftovers of an older version, which used a user service and a file in the home directory.
        local unit="${home}/.config/systemd/user/${LEGACY_SERVICE_NAME}"
        if [[ -f $unit ]]; then
            systemctl --user --machine="${name}@" stop "$LEGACY_SERVICE_NAME" 2>/dev/null || true
            rm -f "$unit" "${home}/.config/systemd/user/default.target.wants/${LEGACY_SERVICE_NAME}"
            systemctl --user --machine="${name}@" daemon-reload 2>/dev/null || true
            echo "cronkid: removed the user service of an older version for user '${name}'"
        fi
        rm -f "${home}/${LEGACY_USED_FILE_NAME}" "${home}/${LEGACY_USED_FILE_NAME}.tmp"
    done < <(getent passwd)
    rm -f "$UNIT_PATH"
    systemctl daemon-reload
    rm -rf "$CONFIG_DIR" "$STATE_DIR"
    rm -f "$INSTALL_PATH"
    echo "cronkid: uninstalled"
}

main() {
    local cmd="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$cmd" in
        setup) cmd_setup "$@" ;;
        remove) cmd_remove "$@" ;;
        status) cmd_status "$@" ;;
        reset) cmd_reset "$@" ;;
        run) cmd_run "$@" ;;
        update) cmd_update "$@" ;;
        version | --version) cmd_version ;;
        uninstall) cmd_uninstall "$@" ;;
        -h | --help | help) usage ;;
        "") usage >&2; exit 1 ;;
        *) echo "cronkid: unknown command: $cmd" >&2; usage >&2; exit 1 ;;
    esac
}

# Running the script executes the command; sourcing it only defines the functions, which is what
# the test suite does. BASH_SOURCE is unset when the script is read from a pipe, where $0 is the
# fallback, so that a piped script still runs.
if [[ ${BASH_SOURCE[0]:-$0} == "$0" ]]; then
    main "$@"
fi
