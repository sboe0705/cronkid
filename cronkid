#!/usr/bin/env bash
#
# cronkid - shell-based parental control that limits the usage time of a user.
#
# Usage:
#   cronkid setup --limit <minutes> [--warn <minutes>] [--user <username>]
#                                     configure and start the control service for the current
#                                     or the given user
#   cronkid remove [--user <username>]  stop and remove the control service
#   cronkid status [--user <username>]  show the remaining time
#   cronkid reset [--user <username>]   reset the used time
#   cronkid update                    replace this script with the latest version from the origin
#   cronkid uninstall                 remove the script, all services and all configuration
#
set -euo pipefail

CRONKID_REPO="sboe0705/cronkid"
CRONKID_BRANCH="main"
INSTALL_PATH="/usr/local/bin/cronkid"
SERVICE_NAME="cronkid.service"
USED_FILE_NAME=".cronkid"
# Version of this script: date and time (without seconds) of the commit it was installed from, and
# the short commit ID. The installer and 'cronkid update' fill this line in, so it is empty in a
# working copy of the repository.
CRONKID_VERSION=""
# Seconds of checks that add one minute of used time.
TICK_SECONDS=60
# Seconds between two checks of the control service. The checks are more frequent than a minute of
# used time, so that a notification the desktop was not ready for yet, a new login and the screen
# lock do not have to wait for the next minute.
CHECK_SECONDS=5
# Minutes before the end at which the first warning is shown, unless --warn says otherwise.
DEFAULT_WARN_MINUTES=5

die() {
    echo "cronkid: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: cronkid <command> [options]

Commands:
  setup --limit <minutes> [--warn <minutes>] [--user <username>]
                            configure and start the control service, warning the user
                            --warn minutes (default ${DEFAULT_WARN_MINUTES}) and 1 minute before the end
  remove [--user <username>]
                            stop and remove the control service
  status [--user <username>]
                            show the remaining time
  reset [--user <username>]
                            reset the used time
  update                    replace this script with the latest version from the origin
  version                   show the version of this script
  uninstall                 remove the script, all services and all configuration

Without --user, a command applies to the current user. With --user it applies to the given
user and requires root (sudo is used automatically).
EOF
}

# Re-executes the current command as root via sudo, unless already running as root.
require_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$(readlink -f "$0")" "$@"
    fi
}

require_non_root() {
    if [[ $EUID -eq 0 ]]; then
        die "this command must be run as the user to be controlled, not as root"
    fi
}

used_file() {
    echo "${HOME}/${USED_FILE_NAME}"
}

# Prints the used minutes of the current user for today. The used-time file holds
# "<date> <minutes>"; minutes recorded on another day count as 0 (daily reset).
read_used() {
    local file date="" used=""
    file="$(used_file)"
    read -r date used 2>/dev/null <"$file" || true
    [[ $date == "$(date +%F)" && $used =~ ^[0-9]+$ ]] || used=0
    echo "$used"
}

write_used() {
    local file
    file="$(used_file)"
    echo "$(date +%F) $1" >"${file}.tmp"
    mv -f "${file}.tmp" "$file"
}

# Prints the base URL to download from. raw.githubusercontent.com caches branch URLs for up to
# 5 minutes (and the GitHub API for 60 seconds), so the latest commit of the branch is read from
# the uncached git smart-HTTP ref advertisement and its immutable URL is used. Falls back to the
# (possibly stale) branch URL if that fails. CRONKID_URL overrides the origin, e.g. for testing.
origin_url() {
    if [[ -n ${CRONKID_URL:-} ]]; then
        echo "$CRONKID_URL"
        return
    fi
    local sha
    sha="$(curl -fsSL --retry 3 --connect-timeout 10 \
        "https://github.com/${CRONKID_REPO}.git/info/refs?service=git-upload-pack" 2>/dev/null \
        | grep -ao "[0-9a-f]\{40\} refs/heads/${CRONKID_BRANCH}\$" | head -n 1 | cut -c 1-40 || true)"
    if [[ $sha =~ ^[0-9a-f]{40}$ ]]; then
        echo "https://raw.githubusercontent.com/${CRONKID_REPO}/${sha}"
    else
        echo "cronkid: cannot resolve latest commit, falling back to branch '${CRONKID_BRANCH}' (may be up to 5 minutes old)" >&2
        echo "https://raw.githubusercontent.com/${CRONKID_REPO}/${CRONKID_BRANCH}"
    fi
}

# Prints the version of the commit <1>: its date and time in UTC, without seconds, and the short
# commit ID, for example "2026-09-20 03:03 UTC b12c9b6". The date of the commit comes from the
# GitHub API, which is only asked while installing or updating; if that fails, only the ID is used.
commit_version() {
    local sha="$1" date
    date="$(curl -fsSL --retry 2 --connect-timeout 10 \
        "https://api.github.com/repos/${CRONKID_REPO}/commits/${sha}" 2>/dev/null \
        | grep -o '"date": *"[0-9-]\{10\}T[0-9:]\{8\}Z"' | head -n 1 \
        | grep -o '[0-9-]\{10\}T[0-9:]\{5\}' | tr 'T' ' ' || true)"
    if [[ -n $date ]]; then
        echo "${date} UTC ${sha:0:7}"
    else
        echo "${sha:0:7}"
    fi
}

# Writes the version <2> into the CRONKID_VERSION line of the script <1>, which is where
# 'cronkid version' reads it from. Returns non-zero without touching the file if the version is not
# plain text or if the script has no such line, as an older version of it has.
stamp_version() {
    local file="$1" version="$2"
    [[ $version =~ ^[0-9A-Za-z\ :-]+$ ]] || return 1
    grep -q '^CRONKID_VERSION=""$' "$file" || return 1
    sed -i "s|^CRONKID_VERSION=\"\"\$|CRONKID_VERSION=\"${version}\"|" "$file"
}

service_dir() {
    echo "${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
}

# Prints the service unit that enforces the limit <1>, warning the user <2> minutes before the end.
service_unit() {
    cat <<EOF
[Unit]
Description=cronkid usage time control (limit: ${1} minutes)

[Service]
Type=simple
ExecStart=${INSTALL_PATH} run --limit ${1} --warn ${2}
Restart=on-failure

[Install]
WantedBy=default.target
EOF
}

# Parses the "[--user <name>]" option of a command into USER_OPTION.
parse_user_option() {
    local cmd="$1"
    shift
    USER_OPTION=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)
                [[ $# -ge 2 ]] || die "--user requires a value"
                USER_OPTION="$2"
                shift 2
                ;;
            *) die "unknown option for ${cmd}: $1" ;;
        esac
    done
}

# Usage: for_other_user <user> <command> <original args...>
# Returns 1 if the command targets the current user (no user given, or the given user is oneself).
# Otherwise validates the user, re-executes the command via sudo if needed and returns 0 as root
# with TARGET_USER, TARGET_UID and TARGET_HOME set.
for_other_user() {
    local user="$1"
    shift
    [[ -n $user ]] || return 1
    [[ $EUID -ne 0 && $user == "$USER" ]] && return 1
    getent passwd "$user" >/dev/null || die "unknown user: ${user}"
    require_root "$@"
    TARGET_USER="$user"
    TARGET_UID="$(id -u "$user")"
    [[ $TARGET_UID -ne 0 ]] || die "the root user cannot be controlled"
    TARGET_HOME="$(getent passwd "$user" | cut -d: -f6)"
    [[ -d $TARGET_HOME ]] || die "home directory of user '${user}' not found: ${TARGET_HOME}"
}

# Runs a cronkid command as the target user, so that root never reads or writes the user's files.
run_as_target() {
    runuser -u "$TARGET_USER" -- env -u XDG_CONFIG_HOME HOME="$TARGET_HOME" USER="$TARGET_USER" \
        LOGNAME="$TARGET_USER" "$(readlink -f "$0")" "$@"
}

target_user_manager_active() {
    systemctl is-active --quiet "user@${TARGET_UID}.service"
}

cmd_setup() {
    local args=("$@") limit="" warn="" user=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit | --warn | --user)
                [[ $# -ge 2 ]] || die "$1 requires a value"
                case "$1" in
                    --limit) limit="$2" ;;
                    --warn) warn="$2" ;;
                    *) user="$2" ;;
                esac
                shift 2
                ;;
            *) die "unknown option for setup: $1" ;;
        esac
    done
    [[ -n $limit ]] || die "setup requires --limit <minutes>"
    [[ $limit =~ ^[1-9][0-9]*$ ]] || die "--limit must be a positive number of minutes"
    [[ -z $warn || $warn =~ ^[1-9][0-9]*$ ]] || die "--warn must be a positive number of minutes"
    warn="$(effective_warn "$limit" "$warn")"

    if for_other_user "$user" setup "${args[@]}"; then
        setup_other_user "$limit" "$warn"
    else
        setup_current_user "$limit" "$warn"
    fi
}

setup_current_user() {
    require_non_root
    local limit="$1" warn="$2" dir
    dir="$(service_dir)"
    mkdir -p "$dir"
    service_unit "$limit" "$warn" >"${dir}/${SERVICE_NAME}"

    systemctl --user daemon-reload
    systemctl --user enable "$SERVICE_NAME"
    systemctl --user restart "$SERVICE_NAME"
    echo "cronkid: control service configured for user '${USER}' with a limit of ${limit} minutes" \
        "(first warning at $(minutes_phrase "$warn") left)"
}

# Runs as root. All files are created as the target user (runuser), so they are owned by that user
# and root never writes through paths the user controls. Enabling is done by creating the same
# symlink as 'systemctl --user enable', which also works while the user is logged out.
setup_other_user() {
    local limit="$1" warn="$2" dir="${TARGET_HOME}/.config/systemd/user"
    runuser -u "$TARGET_USER" -- mkdir -p "${dir}/default.target.wants"
    service_unit "$limit" "$warn" | runuser -u "$TARGET_USER" -- tee "${dir}/${SERVICE_NAME}" >/dev/null
    runuser -u "$TARGET_USER" -- ln -sfn "${dir}/${SERVICE_NAME}" "${dir}/default.target.wants/${SERVICE_NAME}"

    if target_user_manager_active; then
        systemctl --user --machine="${TARGET_USER}@" daemon-reload
        systemctl --user --machine="${TARGET_USER}@" restart "$SERVICE_NAME"
        echo "cronkid: control service configured and started for user '${TARGET_USER}'" \
            "with a limit of ${limit} minutes (first warning at $(minutes_phrase "$warn") left)"
    else
        echo "cronkid: control service configured for user '${TARGET_USER}' with a limit of ${limit} minutes" \
            "(first warning at $(minutes_phrase "$warn") left, starts at the user's next login)"
    fi
}

cmd_remove() {
    parse_user_option remove "$@"
    if for_other_user "$USER_OPTION" remove "$@"; then
        remove_other_user
        return
    fi
    require_non_root
    local unit
    unit="$(service_dir)/${SERVICE_NAME}"
    [[ -f $unit ]] || die "no control service configured for user '${USER}'"
    systemctl --user disable --now "$SERVICE_NAME"
    rm -f "$unit"
    systemctl --user daemon-reload
    echo "cronkid: control service of user '${USER}' removed"
}

# Runs as root. Stops the service if the user is logged in and deletes the unit and its
# 'default.target.wants' symlink as the target user. The used time is kept.
remove_other_user() {
    local dir="${TARGET_HOME}/.config/systemd/user"
    [[ -f ${dir}/${SERVICE_NAME} ]] || die "no control service configured for user '${TARGET_USER}'"
    if target_user_manager_active; then
        systemctl --user --machine="${TARGET_USER}@" stop "$SERVICE_NAME" || true
    fi
    runuser -u "$TARGET_USER" -- rm -f "${dir}/${SERVICE_NAME}" "${dir}/default.target.wants/${SERVICE_NAME}"
    if target_user_manager_active; then
        systemctl --user --machine="${TARGET_USER}@" daemon-reload || true
    fi
    echo "cronkid: control service of user '${TARGET_USER}' removed"
}

# Prints the limit in minutes configured in the user's service, or nothing if there is none.
read_limit() {
    local unit
    unit="$(service_dir)/${SERVICE_NAME}"
    sed -n 's/^ExecStart=.* --limit \([0-9][0-9]*\).*$/\1/p' "$unit" 2>/dev/null | head -n 1 || true
}

cmd_status() {
    parse_user_option status "$@"
    if for_other_user "$USER_OPTION" status "$@"; then
        run_as_target status
        return
    fi
    require_non_root
    local limit used
    limit="$(read_limit)"
    used="$(read_used)"
    if [[ -z $limit ]]; then
        echo "cronkid: no control service configured for user '${USER}' (used today: ${used} minutes)"
        return
    fi
    local remaining=$((limit > used ? limit - used : 0))
    echo "Remaining time of user '${USER}': ${remaining} minutes (used ${used} of ${limit} minutes today)"
}

cmd_reset() {
    parse_user_option reset "$@"
    if for_other_user "$USER_OPTION" reset "$@"; then
        run_as_target reset
        return
    fi
    require_non_root
    write_used 0
    echo "cronkid: used time of user '${USER}' reset"
}

# Prints "1 minute" or "<n> minutes".
minutes_phrase() {
    if (($1 == 1)); then echo "1 minute"; else echo "${1} minutes"; fi
}

# Prints the minutes before the end at which the first warning is shown: the given value, or the
# default if it is empty. A warning that would not fit into the limit is moved to the last minute.
effective_warn() {
    local limit="$1" warn="${2:-$DEFAULT_WARN_MINUTES}"
    if ((warn >= limit)); then warn=1; fi
    echo "$warn"
}

# Shows a desktop notification in the user's session. Returns non-zero if the message could not
# be delivered, for example because the notification daemon of the desktop is not up yet; the
# caller then tries again later. Without notify-send there is nothing to retry, so it returns 0.
notify() {
    local urgency="$1" body="$2"
    command -v notify-send >/dev/null 2>&1 || return 0
    # The service can start before the session has exported the address of its bus.
    if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
        local bus="/run/user/${UID}/bus"
        [[ -S $bus ]] || return 1
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}"
    fi
    notify-send --app-name=cronkid --urgency="$urgency" "Screen time" "$body" 2>/dev/null
}

# Prints the IDs of the user's graphical login sessions, one per line. Only those can show a
# notification, and an ID that was not there before means the user has logged in again.
graphical_sessions() {
    local sessions session type
    sessions="$(loginctl show-user "$USER" --property=Sessions --value 2>/dev/null)" || return 0
    for session in $sessions; do
        type="$(loginctl show-session "$session" --property=Type --value 2>/dev/null)" || continue
        case "$type" in
            x11 | wayland | mir) echo "$session" ;;
        esac
    done
}

# Locks the screen of every session of the user. Sessions that do not support a screen lock,
# such as the session of the user's service manager, are skipped.
lock_sessions() {
    local sessions session
    sessions="$(loginctl show-user "$USER" --property=Sessions --value 2>/dev/null)" || return 0
    # The property holds the session IDs separated by spaces.
    for session in $sessions; do
        loginctl lock-session "$session" >/dev/null 2>&1 || true
    done
}

# Internal command executed by the control service: counts the used minutes, warns the user
# before the end and locks the screen as soon as the limit is reached.
cmd_run() {
    local limit="" warn=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit | --warn)
                [[ $# -ge 2 ]] || die "$1 requires a value"
                if [[ $1 == --limit ]]; then limit="$2"; else warn="$2"; fi
                shift 2
                ;;
            *) die "unknown option for run: $1" ;;
        esac
    done
    [[ $limit =~ ^[1-9][0-9]*$ ]] || die "run requires --limit <minutes>"
    [[ -z $warn || $warn =~ ^[1-9][0-9]*$ ]] || die "--warn must be a positive number of minutes"
    # Units written by an older version have no --warn, so the default applies.
    warn="$(effective_warn "$limit" "$warn")"

    # Each notification is sent once per day, and a flag is only set once the message was really
    # delivered: at login the service usually runs before the notification daemon of the desktop,
    # so undelivered messages are retried on the following checks. The flags are cleared as soon as
    # the remaining time is above the warning again, after 'cronkid reset', at midnight, and for a
    # new login, which gets its own notification.
    local locked=0 announced=0 warned=0 last_warned=0 seen_sessions=" " elapsed=0
    while true; do
        local used remaining sessions session
        used="$(read_used)"
        remaining=$((limit > used ? limit - used : 0))

        # The service keeps running while the user's service manager is up, which outlives a single
        # login. So every graphical session that is new since the last check counts as a login and
        # the notifications are sent again.
        sessions=" "
        for session in $(graphical_sessions); do
            sessions="${sessions}${session} "
            if [[ $seen_sessions != *" ${session} "* ]]; then
                locked=0
                announced=0
                warned=0
                last_warned=0
            fi
        done
        seen_sessions="$sessions"

        if ((remaining > warn)); then
            warned=0
            last_warned=0
            # The notification the user gets after logging in with time left.
            if ((announced == 0)) && notify normal "$(minutes_phrase "$remaining") of screen time left today."; then
                announced=1
            fi
        else
            # Below the threshold the warnings below are the notification for the login.
            announced=1
        fi

        if ((remaining == 0)); then
            # The screen is locked again on every check, so that unlocking it does not buy extra
            # time. Only the first lock of a series is logged, to keep the journal readable.
            if ((locked == 0)); then
                echo "cronkid: limit of ${limit} minutes reached, locking the screen of user '${USER}'"
                notify critical "Your screen time for today is up." || true
                locked=1
            fi
            lock_sessions
        else
            locked=0
            if ((remaining == 1)); then
                if ((last_warned == 0)) && notify critical "The screen will be locked in 1 minute."; then
                    warned=1
                    last_warned=1
                fi
            elif ((remaining <= warn && warned == 0)) && notify normal "Only $(minutes_phrase "$remaining") of screen time left."; then
                warned=1
            fi
        fi

        sleep "$CHECK_SECONDS"
        elapsed=$((elapsed + CHECK_SECONDS))
        if ((elapsed >= TICK_SECONDS)); then
            elapsed=0
            write_used $(($(read_used) + 1))
        fi
    done
}

cmd_version() {
    if [[ -n $CRONKID_VERSION ]]; then
        echo "cronkid ${CRONKID_VERSION}"
    else
        echo "cronkid: no version, this script was not installed by install.sh or 'cronkid update'"
    fi
}

# Downloads the latest script next to the installed one and atomically replaces it. The running
# script keeps reading the old file, and a failed or invalid download leaves the current version intact.
cmd_update() {
    require_root update
    local base url tmp sha version="" suffix=""
    base="$(origin_url)"
    url="${base}/cronkid"
    tmp="$(mktemp "${INSTALL_PATH}.XXXXXX")" || die "cannot create temporary file next to ${INSTALL_PATH}"
    # The value is expanded now, because the trap runs after this function's locals are gone.
    trap "rm -f -- $(printf '%q' "$tmp")" EXIT

    curl -fsSL --retry 3 --connect-timeout 10 "$url" -o "$tmp" \
        || die "download from ${url} failed, keeping current version"
    [[ $(head -c 2 "$tmp") == "#!" ]] || die "downloaded file is not a script, keeping current version"
    # The origin URL ends in the commit the script comes from, unless it fell back to the branch.
    # The version is written into the downloaded script, because a running script cannot know which
    # commit it came from.
    sha="${base##*/}"
    if [[ $sha =~ ^[0-9a-f]{40}$ ]]; then
        version="$(commit_version "$sha")"
        stamp_version "$tmp" "$version" || version=""
    fi
    if [[ -n $version ]]; then
        suffix=" (version ${version})"
    fi
    bash -n "$tmp" || die "downloaded script is not valid bash, keeping current version"
    if cmp -s "$tmp" "$INSTALL_PATH"; then
        echo "cronkid: ${INSTALL_PATH} is already up to date"
        return
    fi
    chmod 0755 "$tmp"
    mv -f "$tmp" "$INSTALL_PATH" || die "cannot replace ${INSTALL_PATH}, keeping current version"
    echo "cronkid: updated ${INSTALL_PATH} from ${base}${suffix}"
}

cmd_uninstall() {
    require_root uninstall
    local name uid home
    while IFS=: read -r name _ uid _ _ home _; do
        [[ -d $home ]] || continue
        local unit="${home}/.config/systemd/user/${SERVICE_NAME}"
        if [[ -f $unit ]]; then
            systemctl --user --machine="${name}@" stop "$SERVICE_NAME" 2>/dev/null || true
            rm -f "$unit" "${home}/.config/systemd/user/default.target.wants/${SERVICE_NAME}"
            systemctl --user --machine="${name}@" daemon-reload 2>/dev/null || true
            echo "cronkid: removed control service of user '${name}'"
        fi
        rm -f "${home}/${USED_FILE_NAME}" "${home}/${USED_FILE_NAME}.tmp"
    done < <(getent passwd)
    rm -f "$INSTALL_PATH"
    echo "cronkid: uninstalled"
}

main() {
    local cmd="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$cmd" in
        setup) cmd_setup "$@" ;;
        remove) cmd_remove "$@" ;;
        status) cmd_status "$@" ;;
        reset) cmd_reset "$@" ;;
        run) cmd_run "$@" ;;
        update) cmd_update "$@" ;;
        version | --version) cmd_version ;;
        uninstall) cmd_uninstall "$@" ;;
        -h | --help | help) usage ;;
        "") usage >&2; exit 1 ;;
        *) echo "cronkid: unknown command: $cmd" >&2; usage >&2; exit 1 ;;
    esac
}

main "$@"
